<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="500.0" style="-fx-background-color: #0b1a4a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets left="16.0" top="16.0" />
            </padding>
            <Button fx:id="backButton" prefHeight="36.0" prefWidth="90.0" style="-fx-background-radius: 7; -fx-cursor: hand; -fx-background-color: #9ea8fd;" text="← Back">
            <font>
               <Font name="Ubuntu Mono Regular" size="10.0" />
            </font></Button>
        </HBox>
    </top>

    <bottom>
        <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: #0b1a4a;">
            <padding>
                <Insets bottom="20.0" top="10.0" />
            </padding>
            <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-text-fill: #ff8e72;" text="" />
            <HBox alignment="CENTER" spacing="14.0">
                <Button fx:id="submitButton" prefHeight="46.0" prefWidth="180.0" style="-fx-background-color: #9ea8fd; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;" text="Submit">
               <font>
                  <Font name="Ubuntu Mono Regular" size="16.0" />
               </font></Button>
            </HBox>
        </VBox>
    </bottom>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label prefHeight="53.0" prefWidth="202.0" text="LOG VITALS" textFill="WHITE">
               <font>
                  <Font name="Ubuntu Mono Regular" size="36.0" />
               </font>
            </Label>
            <Label alignment="CENTER" maxWidth="360.0" text="Add new crew" textAlignment="CENTER" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="Ubuntu Mono Regular" size="12.0" />
               </font>
            </Label>
            <Region prefHeight="58.0" prefWidth="500.0" />
            <Label prefHeight="24.0" prefWidth="27.0" style="-fx-text-fill: #9ea8fd;" text="Name">
               <font>
                  <Font name="Ubuntu Mono Regular" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="nameField" maxWidth="300.0" prefHeight="40.0" promptText="Enter crew name" style="-fx-background-color: #14286b; -fx-text-fill: white; -fx-prompt-text-fill: #7f8fc0; -fx-background-radius: 7; -fx-border-color: #9ea8fd; -fx-border-radius: 7; -fx-border-width: 1.5;" />
         </children>
      </VBox>
   </center>
</BorderPane>
